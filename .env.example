# Copy to ".env" next to the app / .exe. Never commit real keys.

# Powers image models + Veo video (same Google AI Studio key)
GEMINI_API_KEY=

# Media folders (relative to the .exe / project folder)
OUTPUT_DIR=media/images
VIDEO_OUTPUT_DIR=media/videos

API_BALANCE_USD=0
TOTAL_SPENT_USD=0

BILLING_URL=https://aistudio.google.com/billing

DEFAULT_MODEL_ID=gemini-nano-banana-2.1
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_RESOLUTION=2K

NEXT_PUBLIC_APP_NAME=ArnaVideo
